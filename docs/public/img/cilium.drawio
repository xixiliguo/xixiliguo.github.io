        <mxCell id="4qH0Ocg3Wkz9Kyh9P2Yr-21" parent="4qH0Ocg3Wkz9Kyh9P2Yr-1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=left;fontFamily=Cascadia Mono;" value="8.8.8.8:1234 --&amp;gt; 192.168.0.7:30007&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;8.8.8.8 是集群外IP，&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;192.168.0.7:30007 nodePort，后端 10.244&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;.1.3:443&lt;/span&gt;&lt;/div&gt;" vertex="1">
