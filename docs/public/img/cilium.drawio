        <mxCell id="EMI0jdho07xVhJyDclWl-65" parent="EMI0jdho07xVhJyDclWl-1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Cascadia Mono;fillColor=#d5e8d4;strokeColor=#82b366;align=center;verticalAlign=middle;" value="主网卡 eth0" vertex="1">
