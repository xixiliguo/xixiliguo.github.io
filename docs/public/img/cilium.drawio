        <mxCell id="EMI0jdho07xVhJyDclWl-36" parent="EMI0jdho07xVhJyDclWl-1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Cascadia Mono;" value="app" vertex="1">
          <mxGeometry height="40" width="120" x="110" y="-5" as="geometry" />
