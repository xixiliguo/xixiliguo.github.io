        <mxCell id="4qH0Ocg3Wkz9Kyh9P2Yr-23" parent="4qH0Ocg3Wkz9Kyh9P2Yr-1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=left;fontFamily=Cascadia Mono;fillColor=#fff2cc;strokeColor=#d6b656;" value="cil_from_container：&lt;div&gt;1. tuple(dst:8.8.8.8 src:10.244.1.3 dport:443 sport:1234 TUPLE_F_IN) 查CT表，返回CT_REPLY&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;2.&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;fib_redirect_v4里&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;调用 bpf_redirect_neigh转发&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
