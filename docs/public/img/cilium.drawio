        <mxCell id="EMI0jdho07xVhJyDclWl-37" parent="EMI0jdho07xVhJyDclWl-1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=left;fontFamily=Cascadia Mono;" value="10.244.1.3:1234 --&amp;gt; 8.8.8.8:443&lt;div&gt;8.8.8.8 是集群外IP，包离开host时源信息会伪装&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="50" width="310" x="-410" y="-30" as="geometry" />
        </mxCell>
        <mxCell id="EMI0jdho07xVhJyDclWl-38" parent="EMI0jdho07xVhJyDclWl-1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=left;fontFamily=Cascadia Mono;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="无任何包内容修改行为" vertex="1">
          <mxGeometry height="35" width="180" x="250" y="40" as="geometry" />
        </mxCell>
        <mxCell id="EMI0jdho07xVhJyDclWl-39" parent="EMI0jdho07xVhJyDclWl-1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=left;fontFamily=Cascadia Mono;fillColor=#fff2cc;strokeColor=#d6b656;" value="cil_from_container：&lt;div&gt;1. tuple(dst:8.8.8.8 src:10.244.1.3 dport:1234 sport:443 TUPLE_F_IN) 查CT表，结果是new&lt;div&gt;2. 因scope为bidir, swap后以&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;tuple(&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;dst:10.244.1.3 src:8.8.8.8&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;dport:443 sport:1234&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp;TUPLE_F_OUT&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;) 查CT表，结果仍是new&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;3. 检查policy, 通过后&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;以&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); background-color: transparent;&quot;&gt;tuple(&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;dst:10.244.1.3 src:8.8.8.8&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); background-color: transparent;&quot;&gt;dport:443 sport:1234&lt;/span&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); background-color: transparent;&quot;&gt;&amp;nbsp;TUPLE_F_OUT&lt;/span&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); background-color: transparent;&quot;&gt;)&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;为key,创建CT&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;4. 调用 bpf_redirect_neigh转发&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="130" width="640" x="321" y="227" as="geometry" />
        </mxCell>
        <mxCell id="P2pvvPzJDuPGJNEtUVnA-1" edge="1" parent="EMI0jdho07xVhJyDclWl-1" source="EMI0jdho07xVhJyDclWl-42" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.4;exitY=0.1;exitDx=0;exitDy=0;exitPerimeter=0;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="92" y="680" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="EMI0jdho07xVhJyDclWl-42" parent="EMI0jdho07xVhJyDclWl-1" style="ellipse;shape=cloud;whiteSpace=wrap;html=1;fontFamily=Cascadia Mono;fontSize=32;fontStyle=1" value="Network" vertex="1">
          <mxGeometry height="160" width="480" x="-100" y="770" as="geometry" />
        </mxCell>
        <mxCell id="EMI0jdho07xVhJyDclWl-50" parent="EMI0jdho07xVhJyDclWl-1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=left;fontFamily=Cascadia Mono;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;1.&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;nodeport_lb4里判断非nodePort， 进入&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;tail_nodeport_nat_ingress_ipv4&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;2.&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;snat_v4_rev_nat里的动作：&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;生成&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;tuple(dst:eth0 src:8.8.8.8 dport:random sport:443 TUPLE_F_IN)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;snat_v4_rev_nat_handle_mapping里动作：&lt;/span&gt;&lt;/div&gt;&lt;blockquote style=&quot;margin: 0 0 0 40px; border: none; padding: 0px;&quot;&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;以上述tuple查&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;cilium_snat_v4_external， 结果为&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;state(to_daddr:10.244.1.3 to_dport:1234)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;根据state生成&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;otuple(dst:8.8.8.8 src:10.244.1.3 dport:443 sport:1234 TUPLE_F_OUT)继续查snat表&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;如果无记录则创建。防止LRU驱逐掉。&lt;/span&gt;&lt;/div&gt;&lt;/blockquote&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;snat_v4_rewrite_headers根据上面的state信息修改报文目的IP和端口，完成snat的反向动作&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;3.&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;ctx_snat_done_set(ctx); 设置flag&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;4.&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;nodeport_rev_dnat_ipv4检查dnat，&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;tuple(dst:10.244.1.3 src:8.8.8.8 dport:443 sport:1234 TUPLE_F_OUT)&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;CT_ENTRY_NODEPORT 结果为&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;CT_NEW，返回&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;CTX_ACT_OK&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;5. ctx_skip_nodeport_set(ctx);&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;6.&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;tail_handle_ipv4_from_netdev 因上述skip nodeport,进入目的IP为POD的流程。&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;div&gt;7. 继续调用&amp;nbsp;ipv4_local_delivery（入方向限速）--&amp;gt; cil_lxc_policy&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;8.&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); background-color: transparent;&quot;&gt;tuple(&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;dst:10.244.1.3 src:8.8.8.8 dport:443 sport:1234 TUPLE_F_OUT&lt;/span&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); background-color: transparent;&quot;&gt;)查CT表，结果是&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;CT_REPLY&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;9. 因为是reply消息，跳过&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;policy检查&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;10. 调用bpf_redirect_peer转发&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="295" width="738" x="-738" y="402.5" as="geometry" />
        </mxCell>
        <mxCell id="EMI0jdho07xVhJyDclWl-51" parent="EMI0jdho07xVhJyDclWl-1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=left;fontFamily=Cascadia Mono;fillColor=#d5e8d4;strokeColor=#82b366;" value="cil_to_netdev：&lt;div&gt;1. 调用edt_sched_departure检查出方向是否限速&lt;div&gt;2. nodeport_rev_dnat_fwd_ipv4里以&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;tuple(dst:8.8.8.8 src:10.244.1.3 dport:1234 sport:443 TUPLE_F_OUT)查CT表，无结果返回NULL， 即没有dnat信息。&lt;/span&gt;&lt;br&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;3. 尾调用&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;tail_handle_snat_fwd_ipv4，函数不返回上一层&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;4.&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;以&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;tuple(dst:8.8.8.8 src:10.244.1.3 TUPLE_F_OUT)为参数调用&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;snat_v4_needs_masquerade ，如果不需要伪装返回&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;NAT_PUNT_TO_STACK&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;， 需要伪装返回&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;NAT_NEEDED，此时target值为{&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;min_port=NODEPORT_PORT_MIN_NAT, max_port=NODEPORT_PORT_MAX_NAT, from_local_endpoint=true, addr=eth0}&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;5.&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;snat_v4_nat里修改tuple为&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;(dst:8.8.8.8 src:10.244.1.3 dport:443 sport:1234 TUPLE_F_OUT)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;6. &lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;snat_v4_nat_handle_mapping里&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;已上述tuple 查&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;cilium_snat_v4_external ，结果为 NULL&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;7.&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;snat_v4_new_mapping里：&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;random是随机生成的端口，范围在[min_port,max_port]内，优先源端口&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;rstate.to_dport&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;rtuple(dst:eth0 src:8.8.8.8 dport:random sport:443 TUPLE_F_IN)&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;rstate(to_daddr:10.244.1.3 to_dport:1234)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;已上面的信息在map&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;cilium_snat_v4_external 插入&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;RevSNAT&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;记录&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;otuple为(dst:8.8.8.8 src:10.244.1.3 dport:443 sport:1234 TUPLE_F_OUT)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;ostate(to_saddr: eth0 to_sport:rtuple.dport)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;已上面的信息在map&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;cilium_snat_v4_external 插入SNAT记录&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;8. 根据ostate里的信息,修改报文里的源IP和端口，完成SNAT后返回&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;CTX_ACT_OK&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="330" width="730" x="330" y="400" as="geometry" />
        </mxCell>
